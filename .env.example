# Required
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_GROUP_ID=-100xxxxxxxxxx

# Optional
# HTTP port the hook server listens on (127.0.0.1 only), 1024-65535
HOOK_PORT=7890
# Shared secret for hook auth; leave empty to use ~/.cc-sessions/secret (auto-generated)
HOOK_SECRET=
# Close topics after this many hours of inactivity
AUTO_ARCHIVE_HOURS=24
# Session state file; leave empty for ~/.cc-sessions/sessions.json
SESSION_STORE_PATH=
# debug, info, warn, error
LOG_LEVEL=info
# Suppress the dotenv startup tip (the app already passes quiet: true; this is a fallback)
# DOTENV_CONFIG_QUIET=true

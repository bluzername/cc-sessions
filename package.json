{
  "name": "cc-sessions",
  "version": "1.0.0",
  "description": "Real-time mobile monitoring for parallel Claude Code sessions via Telegram",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluzername/cc-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/bluzername/cc-sessions/issues"
  },
  "homepage": "https://github.com/bluzername/cc-sessions#readme",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "cc-sessions": "./bin/cc-sessions.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/ bin/ hooks/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "claude",
    "claude-code",
    "telegram",
    "session-monitor",
    "developer-tools",
    "cli"
  ],
  "author": "bluzername",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "src/",
    "hooks/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "vitest": "^5.0.1"
  }
}

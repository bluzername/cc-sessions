{
  "name": "cc-sessions",
  "version": "1.0.0",
  "description": "Real-time mobile monitoring for parallel Claude Code sessions via Telegram",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "cc-sessions": "./bin/cc-sessions.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/ bin/ hooks/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "claude",
    "claude-code",
    "telegram",
    "session-monitor",
    "developer-tools",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "hooks/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0"
  },
  "devDependencies": {
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "vitest": "^3.0.5"
  }
}
